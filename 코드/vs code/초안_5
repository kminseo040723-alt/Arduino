#include <Adafruit_VL53L0X.h>
#include <Servo.h>
#include <Wire.h>
#include <Adafruit_Sensor.h>

enum SystemMode {
    MODE_IDLE,    
    MODE_RUNNING, 
    MODE_FAIL
};

SystemMode CurrentMode = MODE_IDLE;

enum Signal {
    KEEP,
    NEXT,
    RETRY,
    FAIL
};

enum RobotState {    
    Gripper_Open,    
    Horizontal_Move,    
    Gripper_Close,    
    Climb,    
    Harvest
};
struct StateConfig {
    RobotState state;
    void (*onEnter)();
    Signal (*onUpdate)();
};

// void Gripper_Open_Enter();
// Signal Gripper_Open_Update();

void Horizontal_Move_Enter();
Signal Horizontal_Move_Update();

// void Gripper_Close_Enter();
// Signal Gripper_Close_Update();

// void Climb_Enter();
// Signal Climb_Update();

